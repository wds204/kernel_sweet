# Performance tuning for Redmi Note 10 Pro (sweetin)
# Applied on top of sweetin_defconfig — do not edit base defconfig

# ── CPU Governor ──────────────────────────────────────────
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_INTERACTIVE=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y

# ── I/O Scheduler ─────────────────────────────────────────
CONFIG_IOSCHED_CFQ=y
CONFIG_IOSCHED_BFQ=y
CONFIG_DEFAULT_IOSCHED="bfq"

# ── BPF (required for Android 16 version spoof) ───────────
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_CGROUP_BPF=y

# ── Android 16 QPR2 compatibility ─────────────────────────
CONFIG_ANDROID=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_SECURITY_SELINUX=y

# ── Kernel version spoof string ───────────────────────────
CONFIG_LOCALVERSION="-android14-11-g1234567"
